@model MentorDashboardApp.Models.Course
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
    var isRtl = currentCulture.StartsWith("ar");
    var title = isRtl && !string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleAr : Model.Title;
    var desc = isRtl && !string.IsNullOrEmpty(Model.DescriptionAr) ? Model.DescriptionAr : Model.Description;
    var cleanDesc = System.Text.RegularExpressions.Regex.Replace(desc ?? "", "<.*?>", String.Empty);
    var learn = isRtl && !string.IsNullOrEmpty(Model.WhatYouWillLearnAr) ? Model.WhatYouWillLearnAr : Model.WhatYouWillLearn;
    ViewData["Title"] = title;
    Layout = "_FrontendLayout";
}

<!-- Plyr CSS -->
<link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />

<style>
    .course-details .nav-tabs .nav-link.active { background-color: #0d6efd; color: white; border-radius: 5px; }
    .course-details .nav-tabs .nav-link { color: #333; margin-right: 5px; font-weight: 600; }
    .course-details .tab-content { padding: 20px 0; }
    .curriculum-module { border: 1px solid #eee; margin-bottom: 15px; border-radius: 5px; overflow: hidden; }
    .curriculum-header { background: #f8f9fa; padding: 15px; cursor: pointer; font-weight: bold; display: flex; justify-content: space-between; }
    .curriculum-lessons { display: none; padding: 0; margin: 0; list-style: none; }
    .curriculum-lessons.show { display: block; }
    .curriculum-lesson { padding: 12px 15px; border-top: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
    .curriculum-lesson:hover { background: #fdfdfd; }
    .video-preview-btn { color: #0d6efd; text-decoration: none; font-size: 0.9em; }
    .video-preview-btn:hover { text-decoration: underline; }
    .price-card { position: sticky; top: 100px; background: white; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); padding: 25px; }
    .original-price { text-decoration: line-through; color: #888; font-size: 1.2em; }
    .current-price { font-size: 2.5em; font-weight: bold; color: #000; }
    
    /* Play Button Ripple */
    .play-btn-ripple {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70px;
        height: 70px;
        background: rgba(13, 110, 253, 0.9);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 2rem;
        z-index: 2;
        transition: all 0.3s ease;
    }
    .play-btn-ripple:hover {
        background: #0b5ed7;
        transform: translate(-50%, -50%) scale(1.1);
    }
    .play-btn-ripple::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border-radius: 50%;
        background: rgba(13, 110, 253, 0.5);
        animation: ripple 2s infinite;
        z-index: -1;
    }
    @@keyframes ripple {
        0% { transform: scale(1); opacity: 1; }
        100% { transform: scale(1.6); opacity: 0; }
    }
    
    /* Discount Badge */
    .discount-badge {
        position: absolute;
        top: -15px;
        left: -15px; /* Adjust via inline if RTL */
        background: #dc3545;
        color: white;
        padding: 10px 15px;
        border-radius: 50px;
        font-weight: 800;
        transform: rotate(-10deg);
        box-shadow: 0 4px 10px rgba(220, 53, 69, 0.4);
        z-index: 5;
    }
    
    /* Check List */
    .check-list ul {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }
    @@media (max-width: 768px) {
        .check-list ul { grid-template-columns: 1fr; }
    }
    .check-list li {
        position: relative;
        padding-left: 30px;
        padding-right: 30px;
    }
    .check-list li::before {
        content: '\F26B'; /* Bootstrap check icon */
        font-family: 'Bootstrap Icons';
        position: absolute;
        left: 0; 
        color: #198754;
        font-weight: bold;
        font-size: 1.2rem;
    }
    .rtl .check-list li::before {
        left: auto;
        right: 0;
    }
    
    .meta-item { display: inline-flex; align-items: center; margin-right: 20px; font-size: 0.95rem; }
    .rtl .meta-item { margin-right: 0; margin-left: 20px; }
</style>

<!-- Page Title -->
<div class="page-title dark-background" data-aos="fade" style="background: url('@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "/frontend/assets/img/course-details-bg.jpg")') center center; background-size: cover; position: relative;">
  <div style="background: rgba(0,0,0,0.7); position: absolute; top:0; left:0; width:100%; height:100%;"></div>
  <div class="heading position-relative">
    <div class="container">
      <div class="row d-flex justify-content-center text-center text-md-start @(isRtl ? "rtl" : "")">
        <div class="col-lg-10 text-white">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center justify-content-md-start mb-3" style="background: transparent; padding: 0;">
              <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">@(isRtl ? "الرئيسية" : "Home")</a></li>
              <li class="breadcrumb-item"><a href="/PublicCourses" class="text-white-50 text-decoration-none">@(isRtl ? "الكورسات" : "Courses")</a></li>
              <li class="breadcrumb-item active text-white" aria-current="page">@(Model.Category ?? "General")</li>
            </ol>
          </nav>
          
          <h1 class="display-4 fw-bold mb-3">@title</h1>
          <p class="lead mb-4 opacity-75">@(cleanDesc.Length > 200 ? cleanDesc.Substring(0, 200) + "..." : cleanDesc)</p>
          
          <div class="d-flex flex-wrap justify-content-center justify-content-md-start align-items-center mb-2">
            <div class="meta-item text-warning fw-bold mb-2">
                <span class="me-1">4.8</span>
                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
            </div>
            <div class="meta-item mb-2">
                <i class="bi bi-people-fill me-2"></i> @(new Random().Next(120, 3500)) @(isRtl ? "طالب مسجل" : "Students enrolled")
            </div>
            <div class="meta-item mb-2">
                <i class="bi bi-patch-check-fill text-info me-2"></i> @(isRtl ? "آخر تحديث" : "Last updated") @(Model.CreatedAt.ToString("MM/yyyy"))
            </div>
          </div>
          
          <div class="d-flex justify-content-center justify-content-md-start align-items-center mt-3">
              <img src="~/frontend/assets/img/trainers/trainer-1.jpg" class="rounded-circle" style="width: 45px; height: 45px; border: 2px solid #fff; margin-right: @(isRtl ? "0" : "15px"); margin-left: @(isRtl ? "15px" : "0"); object-fit: cover;" alt="Trainer">
              <span class="fw-semibold">@(Model.Trainer?.FullName ?? (isRtl ? "فريق العمل" : "Our Team"))</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div><!-- End Page Title -->

<section id="course-details" class="course-details section">
  <div class="container">
    <div class="row">
      
      <!-- Main Content -->
      <div class="col-lg-8">
        
        <!-- Tabs -->
        <ul class="nav nav-tabs border-0 mb-3" id="courseTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">@(isRtl ? "نظرة عامة" : "Overview")</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="curriculum-tab" data-bs-toggle="tab" data-bs-target="#curriculum" type="button" role="tab">@(isRtl ? "المنهج الدراسي" : "Curriculum")</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="instructor-tab" data-bs-toggle="tab" data-bs-target="#instructor" type="button" role="tab">@(isRtl ? "المدرب" : "Instructor")</button>
          </li>
        </ul>

        <div class="tab-content" id="courseTabContent">
          
          <!-- Overview Tab -->
          <div class="tab-pane fade show active" id="overview" role="tabpanel">
            <h3>@(isRtl ? "عن هذا الكورس" : "About This Course")</h3>
            <div class="mt-3" style="line-height: 1.8; font-size: 1.05rem;">
                @Html.Raw(desc)
            </div>
            
            @if(!string.IsNullOrEmpty(learn))
            {
                <h4 class="mt-5 mb-4 fw-bold">@(isRtl ? "ماذا ستتعلم في هذا الكورس؟" : "What you will learn in this course?")</h4>
                <div class="p-4 rounded border check-list @(isRtl ? "rtl" : "")" style="background: #fdfdfd;">
                    @Html.Raw(learn)
                </div>
            }
          </div>

          <!-- Curriculum Tab -->
          <div class="tab-pane fade" id="curriculum" role="tabpanel">
            <h3>@(isRtl ? "محتوى الكورس" : "Course Content")</h3>
            <p class="text-muted">
                @(Model.Modules?.Count ?? 0) @(isRtl ? "أقسام" : "Modules") • 
                @(Model.Modules?.Sum(m => m.Lessons.Count) ?? 0) @(isRtl ? "دروس" : "Lessons")
            </p>

            <div class="curriculum-container mt-4">
                @if(Model.Modules != null && Model.Modules.Any())
                {
                    foreach(var mod in Model.Modules)
                    {
                        var modTitle = isRtl && !string.IsNullOrEmpty(mod.TitleAr) ? mod.TitleAr : mod.Title;
                        <div class="curriculum-module">
                            <div class="curriculum-header" onclick="toggleModule(@mod.ModuleId)">
                                <span><i class="bi bi-chevron-down me-2" id="icon_@mod.ModuleId"></i> @modTitle</span>
                                <span>@mod.Lessons.Count @(isRtl ? "دروس" : "Lessons")</span>
                            </div>
                            <ul class="curriculum-lessons" id="lessons_@mod.ModuleId">
                                @foreach(var lesson in mod.Lessons.Where(l => l.IsPublished))
                                {
                                    var lessonTitle = isRtl && !string.IsNullOrEmpty(lesson.TitleAr) ? lesson.TitleAr : lesson.Title;
                                    <li class="curriculum-lesson">
                                        <div>
                                            @if(lesson.LessonType == "Video") { <i class="bi bi-play-circle text-danger me-2"></i> }
                                            else if(lesson.LessonType == "File") { <i class="bi bi-file-earmark-pdf text-success me-2"></i> }
                                            else { <i class="bi bi-file-text text-info me-2"></i> }
                                            @lessonTitle
                                        </div>
                                        <div>
                                            @if(lesson.IsFreePreview)
                                            {
                                                <a href="#" class="video-preview-btn me-3" onclick="openPreviewModal('@lesson.ContentUrl')">@(isRtl ? "معاينة" : "Preview")</a>
                                            }
                                            else
                                            {
                                                <i class="bi bi-lock-fill text-muted me-3" title="Locked"></i>
                                            }
                                            <span class="text-muted">@(lesson.DurationMinutes) @(isRtl ? "د" : "m")</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
                else
                {
                    <p>@(isRtl ? "لم يتم إضافة محتوى بعد." : "No content added yet.")</p>
                }
            </div>
          </div>

          <!-- Instructor Tab -->
          <div class="tab-pane fade" id="instructor" role="tabpanel">
            <h3 class="mb-4">@(isRtl ? "المدرب" : "Instructor")</h3>
            <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start mb-4 border p-4 rounded bg-light">
                @{
                    var tImageUrl = Model.Trainer != null && !string.IsNullOrEmpty(Model.Trainer.ProfileImageUrl) ? Model.Trainer.ProfileImageUrl : "/frontend/assets/img/trainers/trainer-1.jpg";
                    var tSpecialty = Model.Trainer != null ? (isRtl && !string.IsNullOrEmpty(Model.Trainer.SpecialtyAr) ? Model.Trainer.SpecialtyAr : Model.Trainer.Specialty) : (isRtl ? "مدرب وخبير معتمد" : "Certified Expert & Trainer");
                    var tBio = Model.Trainer != null ? (isRtl && !string.IsNullOrEmpty(Model.Trainer.BioAr) ? Model.Trainer.BioAr : Model.Trainer.Bio) : (isRtl ? "لم يتم إضافة نبذة." : "No biography added.");
                }
                <img src="@tImageUrl" alt="Instructor" class="rounded-circle mb-3 mb-md-0" style="width: 120px; height: 120px; object-fit: cover; margin-left: @(isRtl ? "20px" : "0"); margin-right: @(isRtl ? "0" : "20px"); border: 3px solid #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                <div class="text-center text-md-start @(isRtl ? "rtl" : "")">
                    <h4 class="fw-bold mb-1">
                        <a href="@(Model.Trainer != null ? "/Trainers/Details/" + Model.Trainer.UserId : "#")" class="text-dark text-decoration-none">
                            @(Model.Trainer?.FullName ?? (isRtl ? "فريق العمل" : "Our Team"))
                        </a>
                        <i class="bi bi-patch-check-fill text-primary ms-1" style="font-size: 1rem;"></i>
                    </h4>
                    <p class="text-success fw-bold mb-2">@tSpecialty</p>
                    
                    <div class="d-flex justify-content-center justify-content-md-start gap-4 mb-3 text-muted">
                        <div><i class="bi bi-star-fill text-warning"></i> 4.8 @(isRtl ? "تقييم" : "Rating")</div>
                        <div><i class="bi bi-people-fill"></i> 14,500+ @(isRtl ? "طالب" : "Students")</div>
                        <div><i class="bi bi-play-btn-fill"></i> @(isRtl ? "الكورسات" : "Courses")</div>
                    </div>
                    
                    <p class="mb-3">
                        @Html.Raw(tBio?.Replace("\n", "<br>") ?? "")
                    </p>
                    
                    <div>
                        @if (Model.Trainer != null)
                        {
                            @if (!string.IsNullOrEmpty(Model.Trainer.LinkedInUrl)) { <a href="@Model.Trainer.LinkedInUrl" class="btn btn-sm btn-outline-secondary rounded-circle me-2" style="width: 35px; height: 35px; padding-top: 5px;"><i class="bi bi-linkedin"></i></a> }
                            @if (!string.IsNullOrEmpty(Model.Trainer.TwitterUrl)) { <a href="@Model.Trainer.TwitterUrl" class="btn btn-sm btn-outline-secondary rounded-circle me-2" style="width: 35px; height: 35px; padding-top: 5px;"><i class="bi bi-twitter-x"></i></a> }
                            @if (!string.IsNullOrEmpty(Model.Trainer.FacebookUrl)) { <a href="@Model.Trainer.FacebookUrl" class="btn btn-sm btn-outline-secondary rounded-circle me-2" style="width: 35px; height: 35px; padding-top: 5px;"><i class="bi bi-facebook"></i></a> }
                        }
                    </div>
                    <div class="mt-3">
                        <a href="@(Model.Trainer != null ? "/Trainers/Details/" + Model.Trainer.UserId : "#")" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                            @(isRtl ? "عرض الملف الشخصي للمدرب" : "View Full Profile")
                        </a>
                    </div>
                </div>
            </div>
          </div>

        </div>
      </div> <!-- End Main Content -->

      <!-- Sidebar -->
      <div class="col-lg-4">
        <div class="price-card border-top border-4 border-primary">
            @if(!string.IsNullOrEmpty(Model.VideoUrl))
            {
                <div class="mb-4 position-relative" style="cursor: pointer;" onclick="openPreviewModal('@Model.VideoUrl')">
                    @if(Model.DiscountPrice.HasValue && Model.DiscountPrice > 0)
                    {
                        var discountPercent = Math.Round((1 - (Model.DiscountPrice.Value / Model.Price)) * 100);
                        <div class="discount-badge" style="@(isRtl ? "right: -15px; left: auto;" : "")">@(isRtl ? $"خصم {discountPercent}%" : $"{discountPercent}% OFF")</div>
                    }
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/frontend/assets/img/course-details.jpg" : Model.ImageUrl)" class="img-fluid rounded" alt="Course Video">
                    <div class="play-btn-ripple">
                        <i class="bi bi-play-fill" style="margin-left: 4px;"></i>
                    </div>
                    <div class="text-center mt-2 fw-bold" style="font-size: 0.9rem;">
                        <i class="bi bi-play-circle me-1"></i> @(isRtl ? "معاينة هذا الكورس" : "Preview this course")
                    </div>
                </div>
            }

            <div class="pricing mb-4 text-center">
                @if(Model.DiscountPrice.HasValue && Model.DiscountPrice > 0)
                {
                    <span class="original-price me-2 fs-4 text-muted">$@Model.Price</span>
                    <span class="current-price text-danger">$@Model.DiscountPrice</span>
                }
                else if (Model.Price == 0)
                {
                    <span class="current-price text-success">@(isRtl ? "مجاناً" : "Free")</span>
                }
                else
                {
                    <span class="current-price">$@Model.Price</span>
                }
            </div>

            <button class="btn btn-primary btn-lg w-100 mb-3 fw-bold shadow-sm" onclick="enroll(@Model.CourseId)" style="border-radius: 50px; padding: 15px;">
                @(isRtl ? (Model.Price == 0 ? "سجل مجاناً الآن" : "إضافة للسلة") : (Model.Price == 0 ? "Enroll for Free" : "Add to Cart"))
            </button>

            <div class="text-center mb-4 text-muted" style="font-size: 0.85rem;">
                <i class="bi bi-shield-check text-success"></i> @(isRtl ? "ضمان استرداد الأموال خلال 30 يوم" : "30-Day Money-Back Guarantee")
            </div>

            <h6 class="fw-bold mb-3 pb-2 border-bottom">@(isRtl ? "يتضمن هذا الكورس:" : "This course includes:")</h6>
            <ul class="list-unstyled mt-2">
                <li class="mb-3 d-flex align-items-center"><i class="bi bi-play-btn me-3 text-primary fs-5"></i> <span><strong>@(isRtl ? "المدة:" : "Duration:")</strong> @(Model.Duration ?? "Self-paced")</span></li>
                <li class="mb-3 d-flex align-items-center"><i class="bi bi-file-earmark-text me-3 text-primary fs-5"></i> <span><strong>@(isRtl ? "الملفات:" : "Resources:")</strong> @(Model.Modules?.Sum(m => m.Lessons.Count(l => l.LessonType != "Video")) ?? 0) @(isRtl ? "موارد قابلة للتحميل" : "downloadable resources")</span></li>
                <li class="mb-3 d-flex align-items-center"><i class="bi bi-infinity me-3 text-primary fs-5"></i> <span><strong>@(isRtl ? "الوصول:" : "Access:")</strong> @(isRtl ? "وصول كامل مدى الحياة" : "Full lifetime access")</span></li>
                <li class="mb-3 d-flex align-items-center"><i class="bi bi-phone me-3 text-primary fs-5"></i> <span><strong>@(isRtl ? "الأجهزة:" : "Devices:")</strong> @(isRtl ? "الموبايل والتلفزيون" : "Mobile and TV")</span></li>
                <li class="mb-3 d-flex align-items-center"><i class="bi bi-trophy me-3 text-primary fs-5"></i> <span><strong>@(isRtl ? "شهادة:" : "Certificate:")</strong> @(Model.HasCertificate ? (isRtl ? "شهادة إتمام" : "Certificate of completion") : (isRtl ? "لا يوجد شهادة" : "No certificate"))</span></li>
            </ul>
        </div>
      </div> <!-- End Sidebar -->

    </div>
  </div>
</section>

<!-- Video Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content bg-dark">
      <div class="modal-header border-0">
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0" id="previewContainer">
          <!-- Plyr injected here -->
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <!-- Plyr JS -->
    <script src="https://cdn.plyr.io/3.7.8/plyr.js"></script>
    <script>
        function toggleModule(id) {
            const list = document.getElementById('lessons_' + id);
            const icon = document.getElementById('icon_' + id);
            if (list.classList.contains('show')) {
                list.classList.remove('show');
                icon.classList.replace('bi-chevron-up', 'bi-chevron-down');
            } else {
                list.classList.add('show');
                icon.classList.replace('bi-chevron-down', 'bi-chevron-up');
            }
        }

        const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));
        let plyrInstance = null;
        
        function openPreviewModal(url) {
            if(!url) return;
            
            let isYouTube = url.includes('youtube.com') || url.includes('youtu.be');
            let isVimeo = url.includes('vimeo.com');
            
            let containerHtml = '';
            
            if (isYouTube || isVimeo) {
                let embedUrl = url;
                if(url.includes('youtube.com/watch?v=')) {
                    embedUrl = url.replace('watch?v=', 'embed/');
                } else if (url.includes('youtu.be/')) {
                    embedUrl = url.replace('youtu.be/', 'www.youtube.com/embed/');
                }
                
                if(embedUrl.includes('?')) { embedUrl += '&'; } else { embedUrl += '?'; }
                embedUrl += 'iv_load_policy=3&modestbranding=1&playsinline=1&showinfo=0&rel=0&enablejsapi=1';

                containerHtml = `
                <div class="plyr__video-embed" id="previewPlayer">
                  <iframe src="${embedUrl}" allowfullscreen allowtransparency allow="autoplay"></iframe>
                </div>`;
            } else {
                containerHtml = `
                <video id="previewPlayer" playsinline controls>
                  <source src="${url}" type="video/mp4" />
                </video>`;
            }
            
            document.getElementById('previewContainer').innerHTML = containerHtml;
            previewModal.show();
            
            plyrInstance = new Plyr('#previewPlayer', {
                controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'captions', 'settings', 'pip', 'airplay', 'fullscreen'],
                settings: ['quality', 'speed', 'loop']
            });
        }

        document.getElementById('previewModal').addEventListener('hidden.bs.modal', function () {
            if (plyrInstance) {
                plyrInstance.destroy();
                plyrInstance = null;
            }
            document.getElementById('previewContainer').innerHTML = '';
        });

        function enroll(courseId) {
            // For now, redirect to a checkout or direct enrollment endpoint
            window.location.href = '/Enrollment/Checkout?courseId=' + courseId;
        }
    </script>
}
