@model MentorDashboardApp.Models.User
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
    var isRtl = currentCulture.StartsWith("ar");
    ViewData["Title"] = Model.FullName;
    Layout = "_FrontendLayout";
    
    var courses = ViewBag.TrainerCourses as IEnumerable<MentorDashboardApp.Models.Course> ?? new List<MentorDashboardApp.Models.Course>();
    var specialty = isRtl && !string.IsNullOrEmpty(Model.SpecialtyAr) ? Model.SpecialtyAr : Model.Specialty;
    var bio = isRtl && !string.IsNullOrEmpty(Model.BioAr) ? Model.BioAr : Model.Bio;
    var imageUrl = string.IsNullOrEmpty(Model.ProfileImageUrl) ? "/frontend/assets/img/trainers/trainer-1.jpg" : Model.ProfileImageUrl;
}

<div class="page-title dark-background" data-aos="fade" style="background: url('/frontend/assets/img/page-title-bg.jpg') center center; background-size: cover; padding: 60px 0;">
  <div class="container text-center">
    <h1>@(isRtl ? "الملف الشخصي للمدرب" : "Trainer Profile")</h1>
  </div>
</div>

<section class="section">
    <div class="container mt-5 @(isRtl ? "rtl" : "")">
        <div class="row">
            
            <!-- Trainer Sidebar Info -->
            <div class="col-lg-4 mb-5">
                <div class="card shadow-sm border-0 text-center p-4" style="border-radius: 12px; position: sticky; top: 100px;">
                    <img src="@imageUrl" class="img-fluid rounded-circle mx-auto mb-3" style="width: 200px; height: 200px; object-fit: cover; border: 5px solid #e9ecef;" alt="@Model.FullName">
                    <h3 class="fw-bold">@Model.FullName</h3>
                    <p class="text-success fw-bold">@specialty</p>
                    
                    <div class="d-flex justify-content-center gap-3 mt-3 mb-4">
                        @if (!string.IsNullOrEmpty(Model.TwitterUrl)) { <a href="@Model.TwitterUrl" class="text-secondary fs-4"><i class="bi bi-twitter-x"></i></a> }
                        @if (!string.IsNullOrEmpty(Model.FacebookUrl)) { <a href="@Model.FacebookUrl" class="text-secondary fs-4"><i class="bi bi-facebook"></i></a> }
                        @if (!string.IsNullOrEmpty(Model.LinkedInUrl)) { <a href="@Model.LinkedInUrl" class="text-secondary fs-4"><i class="bi bi-linkedin"></i></a> }
                    </div>
                    
                    <ul class="list-group list-group-flush text-start @(isRtl ? "text-end" : "")">
                        <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                            <span class="text-muted"><i class="bi bi-journal-text me-2"></i> @(isRtl ? "الكورسات" : "Courses")</span>
                            <span class="badge bg-primary rounded-pill">@courses.Count()</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                            <span class="text-muted"><i class="bi bi-people me-2"></i> @(isRtl ? "الطلاب" : "Students")</span>
                            <span class="badge bg-success rounded-pill">--</span> <!-- Placeholder for student count -->
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Trainer Bio & Courses -->
            <div class="col-lg-8">
                <div class="mb-5">
                    <h2 class="fw-bold section-title mb-4" style="border-bottom: 2px solid #0d6efd; display: inline-block; padding-bottom: 10px;">
                        @(isRtl ? "نبذة عني" : "About Me")
                    </h2>
                    <p class="lead" style="line-height: 1.8;">@Html.Raw(bio?.Replace("\n", "<br>") ?? (isRtl ? "لم يتم كتابة نبذة تعريفية بعد." : "No biography provided yet."))</p>
                </div>
                
                <div>
                    <h3 class="fw-bold section-title mb-4" style="border-bottom: 2px solid #5fcf80; display: inline-block; padding-bottom: 10px;">
                        @(isRtl ? "كورسات المدرب" : "My Courses")
                    </h3>
                    
                    <div class="row gy-4">
                        @if(!courses.Any())
                        {
                            <div class="col-12 text-center py-5 bg-light rounded">
                                <i class="bi bi-journal-x fs-1 text-muted"></i>
                                <p class="mt-3 text-muted">@(isRtl ? "لا توجد كورسات متاحة حالياً." : "No courses available at the moment.")</p>
                            </div>
                        }
                        
                        @foreach(var course in courses)
                        {
                            var courseTitle = isRtl && !string.IsNullOrEmpty(course.TitleAr) ? course.TitleAr : course.Title;
                            var courseDesc = isRtl && !string.IsNullOrEmpty(course.DescriptionAr) ? course.DescriptionAr : course.Description;
                            
                            <div class="col-md-6 d-flex align-items-stretch" data-aos="zoom-in" data-aos-delay="100">
                              <div class="course-item w-100 shadow-sm rounded overflow-hidden" style="border: 1px solid #eee;">
                                <img src="@course.ImageUrl" class="img-fluid" alt="...">
                                <div class="course-content p-4">
                                  <div class="d-flex justify-content-between align-items-center mb-3">
                                    <p class="category" style="background: #5fcf80; color: white; padding: 4px 12px; border-radius: 4px; font-size: 14px;">@course.Category</p>
                                    <p class="price fw-bold fs-5 text-primary">@(course.DiscountPrice > 0 ? $"${course.DiscountPrice}" : (course.Price == 0 ? (isRtl ? "مجاناً" : "Free") : $"${course.Price}"))</p>
                                  </div>

                                  <h3><a href="/PublicCourses/Details/@course.CourseId" class="text-dark text-decoration-none">@courseTitle</a></h3>
                                  <p class="description text-muted mt-3 mb-0" style="font-size: 14px;">@(string.IsNullOrEmpty(courseDesc) ? "" : (courseDesc.Length > 80 ? courseDesc.Substring(0, 80) + "..." : courseDesc))</p>
                                  
                                </div>
                              </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>
