@model MentorDashboardApp.Models.Course
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
    var isRtl = currentCulture.StartsWith("ar");
    var courseTitle = isRtl && !string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleAr : Model.Title;
    
    var currentLesson = ViewBag.CurrentLesson as MentorDashboardApp.Models.CourseLesson;
    var currentLessonTitle = currentLesson != null 
        ? (isRtl && !string.IsNullOrEmpty(currentLesson.TitleAr) ? currentLesson.TitleAr : currentLesson.Title) 
        : "";

    var allLessons = Model.Modules.SelectMany(m => m.Lessons.Where(l => l.IsPublished)).ToList();
    var currentIndex = allLessons.FindIndex(l => l.LessonId == currentLesson?.LessonId);
    
    var prevLesson = currentIndex > 0 ? allLessons[currentIndex - 1] : null;
    var nextLesson = currentIndex >= 0 && currentIndex < allLessons.Count - 1 ? allLessons[currentIndex + 1] : null;

    var completedLessonIds = ViewBag.CompletedLessonIds as List<int> ?? new List<int>();
    bool isCompleted = currentLesson != null && completedLessonIds.Contains(currentLesson.LessonId);

    ViewData["Title"] = $"{courseTitle} - {currentLessonTitle}";
    Layout = null; // Use a custom standalone layout for LMS Player
}

<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">
    <!-- Vendor CSS Files -->
    <link href="~/frontend/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/frontend/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Plyr CSS -->
    <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
    
    <style>
        body { font-family: @(isRtl ? "'Cairo', sans-serif" : "'Open Sans', sans-serif"); margin: 0; padding: 0; background: #f8f9fa; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        
        /* Navbar */
        .lms-navbar { background: #1c1d1f; color: white; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; z-index: 1000; height: 60px; }
        .lms-navbar a { color: white; text-decoration: none; }
        .course-title-nav { font-weight: 600; margin-left: @(isRtl ? "0" : "20px"); margin-right: @(isRtl ? "20px" : "0"); border-left: @(isRtl ? "none" : "1px solid #3e4143"); border-right: @(isRtl ? "1px solid #3e4143" : "none"); padding-left: @(isRtl ? "0" : "20px"); padding-right: @(isRtl ? "20px" : "0"); }
        
        /* Main Container */
        .lms-container { display: flex; flex: 1; overflow: hidden; }
        
        /* Content Area (Video) */
        .lms-content { flex: 1; overflow-y: auto; display: flex; flex-direction: column; background: #fff; }
        .video-container { background: #000; position: relative; width: 100%; display: flex; align-items: center; justify-content: center; }
        /* Plyr overrides to fit the container */
        .plyr { width: 100%; height: 100%; max-height: calc(100vh - 135px); }
        
        /* Sidebar (Curriculum) */
        .lms-sidebar { width: 350px; background: #fff; border-left: @(isRtl ? "none" : "1px solid #d1d7dc"); border-right: @(isRtl ? "1px solid #d1d7dc" : "none"); overflow-y: auto; display: flex; flex-direction: column; }
        .sidebar-header { padding: 15px; font-weight: bold; border-bottom: 1px solid #d1d7dc; background: #f8f9fa; }
        
        .module-header { padding: 15px; background: #fbfbf8; border-bottom: 1px solid #d1d7dc; cursor: pointer; font-weight: 600; display: flex; justify-content: space-between; align-items: center; }
        .lesson-list { list-style: none; padding: 0; margin: 0; display: none; }
        .lesson-list.show { display: block; }
        .lesson-item { padding: 10px 15px; border-bottom: 1px solid #eee; display: flex; align-items: flex-start; cursor: pointer; text-decoration: none; color: #1c1d1f; }
        .lesson-item:hover { background: #f8f9fa; }
        .lesson-item.active { background: #e6f2f5; border-left: @(isRtl ? "none" : "3px solid #0d6efd"); border-right: @(isRtl ? "3px solid #0d6efd" : "none"); }
        
        .lesson-icon { margin-top: 3px; margin-right: @(isRtl ? "0" : "10px"); margin-left: @(isRtl ? "10px" : "0"); color: #6a6f73; }
        .lesson-item.active .lesson-icon { color: #0d6efd; }
        
        /* Adjustments for smaller screens */
        @@media (max-width: 991.98px) {
            .lms-container { flex-direction: column; overflow-y: auto; }
            .lms-sidebar { width: 100%; height: auto; flex: none; border: none; border-top: 1px solid #d1d7dc; }
            .lms-content { flex: none; height: auto; }
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <div class="lms-navbar">
        <div class="d-flex align-items-center">
            <a href="/PublicCourses/Details/@Model.CourseId"><i class="bi bi-chevron-@(isRtl ? "right" : "left")"></i> @(isRtl ? "العودة للكورس" : "Back to Course")</a>
            <span class="course-title-nav d-none d-md-block">@courseTitle</span>
        </div>
        <div>
            <a href="/Home/Index" class="btn btn-sm btn-outline-light">@(isRtl ? "لوحة التحكم" : "Dashboard")</a>
        </div>
    </div>

    <div class="lms-container">
        <!-- Content Area -->
        <div class="lms-content">
            @if (currentLesson != null)
            {
                if (currentLesson.LessonType == "Video")
                {
                    <div class="video-container">
                        @{
                            var videoUrl = currentLesson.ContentUrl ?? "";
                            bool isYouTube = videoUrl.Contains("youtube.com") || videoUrl.Contains("youtu.be");
                            bool isVimeo = videoUrl.Contains("vimeo.com");
                        }
                        
                        @if (isYouTube || isVimeo)
                        {
                            if(videoUrl.Contains("youtube.com/watch?v="))
                            {
                                videoUrl = videoUrl.Replace("watch?v=", "embed/");
                            }
                            else if(videoUrl.Contains("youtu.be/"))
                            {
                                videoUrl = videoUrl.Replace("youtu.be/", "www.youtube.com/embed/");
                            }
                            
                            if(videoUrl.Contains("?")) { videoUrl += "&"; } else { videoUrl += "?"; }
                            videoUrl += "iv_load_policy=3&modestbranding=1&playsinline=1&showinfo=0&rel=0&enablejsapi=1";
                            
                            <div class="plyr__video-embed" id="player">
                                <iframe src="@videoUrl" allowfullscreen allowtransparency allow="autoplay"></iframe>
                            </div>
                        }
                        else
                        {
                            <video id="player" playsinline controls>
                                <source src="@videoUrl" type="video/mp4" />
                            </video>
                        }
                    </div>
                }
                else if (currentLesson.LessonType == "File")
                {
                    <div class="p-5 text-center mt-5">
                        <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 5rem;"></i>
                        <h3 class="mt-3">@currentLessonTitle</h3>
                        <p class="text-muted">@(isRtl ? "هذا الدرس عبارة عن ملف للتحميل." : "This lesson is a downloadable file.")</p>
                        <a href="@currentLesson.ContentUrl" target="_blank" class="btn btn-primary mt-3"><i class="bi bi-download"></i> @(isRtl ? "تحميل الملف" : "Download File")</a>
                    </div>
                }
                else
                {
                    <div class="p-4 p-md-5">
                        <h2 class="mb-4">@currentLessonTitle</h2>
                        <div class="lesson-text-content fs-5" style="line-height: 1.8;">
                            @Html.Raw(currentLesson.TextContent)
                        </div>
                    </div>
                }
                
                <!-- Lesson Navigation below content -->
                <div class="p-4 border-top mt-auto d-flex justify-content-between align-items-center bg-light flex-wrap gap-2">
                    
                    @if (prevLesson != null)
                    {
                        <a href="/LMS/Player?courseId=@Model.CourseId&lessonId=@prevLesson.LessonId" class="btn btn-outline-secondary">
                            <i class="bi bi-chevron-@(isRtl ? "right" : "left")"></i> @(isRtl ? "الدرس السابق" : "Previous")
                        </a>
                    }
                    else
                    {
                        <div></div> <!-- Placeholder for flex alignment -->
                    }
                    
                    <button id="btnMarkComplete" class="btn @(isCompleted ? "btn-secondary disabled" : "btn-success")" onclick="markAsComplete(@Model.CourseId, @currentLesson.LessonId, @(nextLesson != null ? nextLesson.LessonId.ToString() : "null"))">
                        <i class="bi bi-check-circle"></i> @(isCompleted ? (isRtl ? "مكتمل" : "Completed") : (isRtl ? "تحديد كمكتمل" : "Mark as Complete"))
                    </button>
                    
                    @if (nextLesson != null)
                    {
                        <a href="/LMS/Player?courseId=@Model.CourseId&lessonId=@nextLesson.LessonId" class="btn btn-primary" id="btnNextLesson">
                            @(isRtl ? "الدرس التالي" : "Next") <i class="bi bi-chevron-@(isRtl ? "left" : "right")"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-warning fw-bold text-dark" onclick="finishCourse()">
                            <i class="bi bi-trophy"></i> @(isRtl ? "إنهاء الكورس" : "Finish Course")
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="p-5 text-center mt-5">
                    <i class="bi bi-exclamation-circle text-muted" style="font-size: 5rem;"></i>
                    <h3 class="mt-3">@(isRtl ? "لم يتم إضافة دروس بعد" : "No lessons available yet")</h3>
                </div>
            }
        </div>

        <!-- Curriculum Sidebar -->
        <div class="lms-sidebar">
            <div class="sidebar-header">
                @(isRtl ? "محتوى الكورس" : "Course Content")
            </div>
            
            @if(Model.Modules != null)
            {
                foreach(var mod in Model.Modules)
                {
                    var modTitle = isRtl && !string.IsNullOrEmpty(mod.TitleAr) ? mod.TitleAr : mod.Title;
                    // Check if current lesson is in this module to auto-expand
                    bool isCurrentMod = currentLesson != null && currentLesson.ModuleId == mod.ModuleId;
                    
                    <div class="module-section">
                        <div class="module-header" onclick="toggleModule(@mod.ModuleId)">
                            <div>
                                <div class="mb-1">@modTitle</div>
                                <small class="text-muted fw-normal">@mod.Lessons.Count @(isRtl ? "دروس" : "Lessons")</small>
                            </div>
                            <i class="bi bi-chevron-@(isCurrentMod ? "up" : "down")" id="icon_@mod.ModuleId"></i>
                        </div>
                        
                        <ul class="lesson-list @(isCurrentMod ? "show" : "")" id="lessons_@mod.ModuleId">
                            @foreach(var lesson in mod.Lessons.Where(l => l.IsPublished))
                            {
                                var lessonTitle = isRtl && !string.IsNullOrEmpty(lesson.TitleAr) ? lesson.TitleAr : lesson.Title;
                                bool isActive = currentLesson != null && currentLesson.LessonId == lesson.LessonId;
                                bool lessonCompleted = completedLessonIds.Contains(lesson.LessonId);
                                
                                <a href="/LMS/Player?courseId=@Model.CourseId&lessonId=@lesson.LessonId" class="lesson-item @(isActive ? "active" : "")">
                                    <div class="lesson-icon">
                                        @if(lessonCompleted) { <i class="bi bi-check-circle-fill text-success"></i> }
                                        else if(lesson.LessonType == "Video") { <i class="bi bi-play-circle"></i> }
                                        else if(lesson.LessonType == "File") { <i class="bi bi-file-earmark-pdf"></i> }
                                        else { <i class="bi bi-file-text"></i> }
                                    </div>
                                    <div class="w-100">
                                        <div style="font-size: 0.95em;" class="@(lessonCompleted ? "text-success fw-bold" : "")">@lessonTitle</div>
                                        <div class="text-muted mt-1" style="font-size: 0.8em;"><i class="bi bi-clock"></i> @lesson.DurationMinutes @(isRtl ? "د" : "min")</div>
                                    </div>
                                </a>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Completion Modal -->
    <div class="modal fade" id="completionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered text-center">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-body p-5 bg-white">
                    <div class="mb-4">
                        <i class="bi bi-trophy-fill text-warning" style="font-size: 5rem; text-shadow: 0 4px 10px rgba(255, 193, 7, 0.4);"></i>
                    </div>
                    <h2 class="fw-bold mb-3 text-dark">@(isRtl ? "ألف مبروك!" : "Congratulations!")</h2>
                    <p class="text-muted fs-5 mb-4">
                        @(isRtl ? "لقد أتممت الكورس بنجاح بنسبة 100%. فخورون بك وبمجهودك الرائع." : "You have successfully completed 100% of this course. We are proud of your amazing effort.")
                    </p>
                    <div class="d-grid gap-2">
                        <a href="/PublicCourses/Details/@Model.CourseId" class="btn btn-primary btn-lg rounded-pill">
                            <i class="bi bi-house-door me-2"></i>@(isRtl ? "العودة لصفحة الكورس" : "Back to Course Page")
                        </a>
                        <a href="/Home/Index" class="btn btn-light btn-lg rounded-pill mt-2">
                            @(isRtl ? "لوحة التحكم الرئيسية" : "Main Dashboard")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vendor JS Files -->
    <script src="~/frontend/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Plyr JS -->
    <script src="https://cdn.plyr.io/3.7.8/plyr.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const playerElement = document.getElementById('player');
            if (playerElement) {
                const player = new Plyr(playerElement, {
                    controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'captions', 'settings', 'pip', 'airplay', 'fullscreen'],
                    settings: ['quality', 'speed', 'loop']
                });
            }
        });

        function toggleModule(id) {
            const list = document.getElementById('lessons_' + id);
            const icon = document.getElementById('icon_' + id);
            if (list.classList.contains('show')) {
                list.classList.remove('show');
                icon.classList.replace('bi-chevron-up', 'bi-chevron-down');
            } else {
                list.classList.add('show');
                icon.classList.replace('bi-chevron-down', 'bi-chevron-up');
            }
        }

        function markAsComplete(courseId, lessonId, nextLessonId) {
            fetch('/LMS/MarkAsComplete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CourseId: courseId, LessonId: lessonId })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    if(nextLessonId) {
                        window.location.href = `/LMS/Player?courseId=${courseId}&lessonId=${nextLessonId}`;
                    } else {
                        // If there is no next lesson, trigger the completion modal immediately
                        finishCourse();
                    }
                }
            });
        }

        function finishCourse() {
            var completionModal = new bootstrap.Modal(document.getElementById('completionModal'));
            completionModal.show();
            
            // Fire Confetti! 🎉
            var duration = 3 * 1000;
            var animationEnd = Date.now() + duration;
            var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 1060 };

            function randomInRange(min, max) {
              return Math.random() * (max - min) + min;
            }

            var interval = setInterval(function() {
              var timeLeft = animationEnd - Date.now();

              if (timeLeft <= 0) {
                return clearInterval(interval);
              }

              var particleCount = 50 * (timeLeft / duration);
              confetti(Object.assign({}, defaults, { particleCount,
                origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 }
              }));
              confetti(Object.assign({}, defaults, { particleCount,
                origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 }
              }));
            }, 250);
        }
    </script>
</body>
</html>
