@model IEnumerable<MentorDashboardApp.Models.Enrollment>
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
    var isRtl = currentCulture.StartsWith("ar");
    ViewData["Title"] = isRtl ? "كورساتي" : "My Courses";
    Layout = "_FrontendLayout";
}

<div class="page-title dark-background" data-aos="fade" style="background: url('/frontend/assets/img/page-title-bg.jpg') center center; background-size: cover; padding: 60px 0;">
  <div class="container text-center">
    <h1>@(isRtl ? "لوحة التعلم (كورساتي)" : "My Learning Dashboard")</h1>
  </div>
</div>

<section class="section">
    <div class="container mt-5 mb-5 @(isRtl ? "rtl" : "")">
        <div class="row">
            <div class="col-12 mb-4">
                <h3 class="fw-bold section-title mb-4" style="border-bottom: 2px solid #0d6efd; display: inline-block; padding-bottom: 10px;">
                    @(isRtl ? "مرحباً بك،" : "Welcome,") @User.Identity?.Name!
                </h3>
            </div>
        </div>

        <div class="row gy-4">
            @if(!Model.Any())
            {
                <div class="col-12 text-center py-5 bg-light rounded" style="border: 2px dashed #ccc;">
                    <i class="bi bi-journal-x fs-1 text-muted"></i>
                    <h4 class="mt-3">@(isRtl ? "لم تقم بالتسجيل في أي كورس بعد." : "You haven't enrolled in any courses yet.")</h4>
                    <p class="text-muted">@(isRtl ? "تصفح مكتبتنا وابدأ رحلة التعلم اليوم!" : "Browse our library and start your learning journey today!")</p>
                    <a href="/PublicCourses" class="btn btn-primary mt-3 px-4 py-2" style="border-radius: 50px;">@(isRtl ? "تصفح الكورسات" : "Browse Courses")</a>
                </div>
            }
            
            @foreach(var enrollment in Model)
            {
                var course = enrollment.Course;
                if(course == null) continue;
                
                var courseTitle = isRtl && !string.IsNullOrEmpty(course.TitleAr) ? course.TitleAr : course.Title;
                
                <div class="col-md-6 col-lg-4 d-flex align-items-stretch" data-aos="zoom-in" data-aos-delay="100">
                    <div class="course-item w-100 shadow-sm rounded overflow-hidden position-relative" style="border: 1px solid #eee;">
                        
                        <img src="@(string.IsNullOrEmpty(course.ImageUrl) ? "/frontend/assets/img/course-details.jpg" : course.ImageUrl)" class="img-fluid w-100" style="height: 200px; object-fit: cover;" alt="...">
                        
                        <div class="course-content p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <p class="category" style="background: #5fcf80; color: white; padding: 4px 12px; border-radius: 4px; font-size: 14px;">@course.Category</p>
                                <p class="text-muted" style="font-size: 12px;"><i class="bi bi-calendar3 me-1"></i> @enrollment.EnrollmentDate.ToString("dd MMM yyyy")</p>
                            </div>

                            <h4 class="mb-3"><a href="/LMS/Player?courseId=@course.CourseId" class="text-dark text-decoration-none fw-bold">@courseTitle</a></h4>
                            
                            <!-- Progress Bar (Static for now) -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between text-muted" style="font-size: 0.85rem; margin-bottom: 5px;">
                                    <span>@(isRtl ? "نسبة الإنجاز" : "Progress")</span>
                                    <span>0%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                            
                            <a href="/LMS/Player?courseId=@course.CourseId" class="btn btn-outline-primary w-100 fw-bold" style="border-radius: 50px;">
                                <i class="bi bi-play-circle me-2"></i> @(isRtl ? "متابعة التعلم" : "Continue Learning")
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
