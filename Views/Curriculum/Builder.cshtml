@model MentorDashboardApp.Models.Course
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isRtl ? $"محتوى الكورس: {Model.TitleAr ?? Model.Title}" : $"Curriculum: {Model.Title}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .module-card { margin-bottom: 15px; border: 1px solid #ddd; border-radius: 5px; }
    .module-header { background: #f8f9fa; padding: 10px 15px; cursor: move; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd;}
    .lesson-list { padding: 10px; min-height: 50px; background: #fff;}
    .lesson-item { border: 1px solid #eee; margin-bottom: 8px; padding: 10px; background: #fdfdfd; cursor: move; display: flex; justify-content: space-between; align-items: center; border-radius: 4px; border-left: 3px solid #0d6efd; }
    .lesson-item.is-draft { border-left-color: #dc3545; opacity: 0.7; }
</style>

<div class="pagetitle d-flex justify-content-between align-items-center">
    <div>
        <h1>@(isRtl ? "مُنشئ المحتوى والدروس" : "Curriculum Builder")</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Courses/Index">@(isRtl ? "الكورسات" : "Courses")</a></li>
                <li class="breadcrumb-item active">@(isRtl ? Model.TitleAr ?? Model.Title : Model.Title)</li>
            </ol>
        </nav>
    </div>
    <button class="btn btn-primary" onclick="openModuleModal()">
        <i class="bi bi-plus-circle"></i> @(isRtl ? "إضافة قسم جديد" : "Add Module")
    </button>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div id="modulesContainer">
                @foreach (var mod in Model.Modules)
                {
                    <div class="module-card bg-white" data-id="@mod.ModuleId">
                        <div class="module-header">
                            <div>
                                <i class="bi bi-grip-vertical text-muted me-2"></i>
                                <strong>@(isRtl ? mod.TitleAr ?? mod.Title : mod.Title)</strong>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-primary" onclick="openLessonModal(@mod.ModuleId)"><i class="bi bi-plus"></i> @(isRtl ? "درس" : "Lesson")</button>
                                <button class="btn btn-sm btn-outline-secondary" onclick="editModule(@mod.ModuleId, '@mod.Title', '@mod.TitleAr')"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteModule(@mod.ModuleId)"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                        <div class="lesson-list" id="lessonList_@mod.ModuleId">
                            @foreach (var lesson in mod.Lessons)
                            {
                                <div class="lesson-item @(lesson.IsPublished ? "" : "is-draft")" data-id="@lesson.LessonId">
                                    <div>
                                        <i class="bi bi-grip-vertical text-muted me-2"></i>
                                        @if(lesson.LessonType == "Video") { <i class="bi bi-play-circle-fill text-danger me-2"></i> }
                                        else if(lesson.LessonType == "File") { <i class="bi bi-file-earmark-pdf-fill text-success me-2"></i> }
                                        else { <i class="bi bi-file-text-fill text-info me-2"></i> }
                                        
                                        <span>@(isRtl ? lesson.TitleAr ?? lesson.Title : lesson.Title)</span>
                                        
                                        @if(lesson.IsFreePreview)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">@(isRtl ? "معاينة مجانية" : "Free Preview")</span>
                                        }
                                        @if(!lesson.IsPublished)
                                        {
                                            <span class="badge bg-danger ms-2">@(isRtl ? "مسودة" : "Draft")</span>
                                        }
                                    </div>
                                    <div>
                                        <small class="text-muted me-3">@(lesson.DurationMinutes) @(isRtl ? "دقيقة" : "min")</small>
                                        <button class="btn btn-sm btn-light" onclick="editLesson(@lesson.LessonId, @mod.ModuleId, '@lesson.Title', '@lesson.TitleAr', '@lesson.LessonType', '@lesson.ContentUrl', '@lesson.TextContent', @(lesson.DurationMinutes ?? 0), @(lesson.IsFreePreview.ToString().ToLower()))"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-light text-danger" onclick="deleteLesson(@lesson.LessonId)"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            @if(!Model.Modules.Any())
            {
                <div class="text-center py-5 mt-4" id="emptyState" style="border: 2px dashed #d1d7dc; border-radius: 10px; background: #f8f9fa;">
                    <img src="~/frontend/assets/img/hero-bg.jpg" alt="Empty" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; opacity: 0.5; margin-bottom: 20px;">
                    <h3 class="text-muted mb-3">@(isRtl ? "مرحباً بك في منشئ الدروس!" : "Welcome to the Curriculum Builder!")</h3>
                    <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
                        @(isRtl ? "قم ببناء هيكل دورتك التدريبية بكل سهولة. ابدأ بإنشاء الأقسام الرئيسية أولاً، ثم قم بإضافة الدروس ومقاطع الفيديو داخل كل قسم." : "Build your course structure easily. Start by creating main modules, then add lessons and videos inside each module.")
                    </p>
                    <button class="btn btn-primary btn-lg" onclick="openModuleModal()">
                        <i class="bi bi-plus-circle me-2"></i>@(isRtl ? "أضف قسمك الأول الآن" : "Add Your First Module Now")
                    </button>
                </div>
            }
        </div>
    </div>
</section>

<!-- Module Modal -->
<div class="modal fade" id="moduleModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="moduleModalTitle">
            <i class="bi bi-folder-plus text-primary me-2"></i> @(isRtl ? "إضافة قسم" : "Add Module")
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <input type="hidden" id="moduleId" value="0">
        
        <!-- Language Tabs -->
        <ul class="nav nav-tabs mb-3" id="moduleLangTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(isRtl ? "active" : "")" id="mod-ar-tab" data-bs-toggle="tab" data-bs-target="#mod-ar" type="button" role="tab">العربية</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(!isRtl ? "active" : "")" id="mod-en-tab" data-bs-toggle="tab" data-bs-target="#mod-en" type="button" role="tab">English</button>
            </li>
        </ul>
        
        <div class="tab-content" id="moduleLangTabsContent">
            <div class="tab-pane fade @(isRtl ? "show active" : "")" id="mod-ar" role="tabpanel">
                <div class="mb-3">
                    <label class="form-label text-muted">عنوان القسم</label>
                    <input type="text" class="form-control form-control-lg" id="modTitleAr" dir="rtl" placeholder="مثال: مقدمة في لغة بايثون">
                </div>
            </div>
            <div class="tab-pane fade @(!isRtl ? "show active" : "")" id="mod-en" role="tabpanel">
                <div class="mb-3">
                    <label class="form-label text-muted">Module Title</label>
                    <input type="text" class="form-control form-control-lg" id="modTitle" dir="ltr" placeholder="e.g. Introduction to Python">
                </div>
            </div>
        </div>
        
      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@(isRtl ? "إلغاء" : "Cancel")</button>
        <button type="button" class="btn btn-primary px-4" onclick="saveModule()">@(isRtl ? "حفظ القسم" : "Save Module")</button>
      </div>
    </div>
  </div>
</div>

<!-- Lesson Modal -->
<div class="modal fade" id="lessonModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="lessonModalTitle">
            <i class="bi bi-file-earmark-plus text-primary me-2"></i> @(isRtl ? "إضافة درس" : "Add Lesson")
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <input type="hidden" id="lessonId" value="0">
        <input type="hidden" id="lessonModuleId" value="0">
        
        <!-- Language Tabs for Lesson Title -->
        <ul class="nav nav-tabs mb-3" id="lessonLangTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(isRtl ? "active" : "")" id="less-ar-tab" data-bs-toggle="tab" data-bs-target="#less-ar" type="button" role="tab">العربية</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(!isRtl ? "active" : "")" id="less-en-tab" data-bs-toggle="tab" data-bs-target="#less-en" type="button" role="tab">English</button>
            </li>
        </ul>
        
        <div class="tab-content mb-4" id="lessonLangTabsContent">
            <div class="tab-pane fade @(isRtl ? "show active" : "")" id="less-ar" role="tabpanel">
                <div>
                    <label class="form-label text-muted">عنوان الدرس</label>
                    <input type="text" class="form-control form-control-lg" id="lessonTitleAr" dir="rtl" placeholder="عنوان الدرس...">
                </div>
            </div>
            <div class="tab-pane fade @(!isRtl ? "show active" : "")" id="less-en" role="tabpanel">
                <div>
                    <label class="form-label text-muted">Lesson Title</label>
                    <input type="text" class="form-control form-control-lg" id="lessonTitle" dir="ltr" placeholder="Lesson Title...">
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold">@(isRtl ? "نوع الدرس" : "Lesson Type")</label>
                <select class="form-select" id="lessonType" onchange="toggleLessonFields()">
                    <option value="Video">@(isRtl ? "فيديو (يوتيوب/درايف)" : "Video (YouTube/Drive)")</option>
                    <option value="File">@(isRtl ? "ملف (PDF/ZIP)" : "File (PDF/ZIP)")</option>
                    <option value="Text">@(isRtl ? "مقال / نص" : "Text Article")</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@(isRtl ? "المدة المتوقعة (بالدقائق)" : "Estimated Duration (Minutes)")</label>
                <div class="input-group">
                    <input type="number" class="form-control" id="lessonDuration" value="0" min="0">
                    <span class="input-group-text bg-light">@(isRtl ? "دقيقة" : "Min")</span>
                </div>
            </div>
        </div>

        <div class="mb-4 bg-light p-3 rounded" id="urlField">
            <label class="form-label fw-bold">@(isRtl ? "رابط الفيديو / الملف" : "Video/File URL")</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                <input type="text" class="form-control" id="lessonUrl" dir="ltr" placeholder="https://...">
            </div>
            <small class="text-muted mt-1 d-block" id="urlHint">@(isRtl ? "ضع رابط فيديو يوتيوب أو رابط جوجل درايف العام." : "Paste a YouTube or public Google Drive link.")</small>
        </div>

        <div class="mb-4" id="textField" style="display:none;">
            <label class="form-label fw-bold">@(isRtl ? "المحتوى النصي" : "Text Content")</label>
            <textarea class="form-control" id="lessonText" rows="6" placeholder="@(isRtl ? "اكتب محتوى الدرس هنا..." : "Write lesson content here...")"></textarea>
        </div>

        <div class="form-check form-switch p-3 border rounded bg-light d-flex align-items-center">
            <input class="form-check-input ms-0 me-3" type="checkbox" id="lessonFreePreview" style="transform: scale(1.5);">
            <label class="form-check-label ms-3 fw-bold" for="lessonFreePreview">
                @(isRtl ? "إتاحة هذا الدرس للمعاينة مجاناً" : "Make this lesson available for free preview")
                <small class="d-block text-muted fw-normal mt-1">@(isRtl ? "سيتمكن الطلاب غير المسجلين من مشاهدة هذا الدرس قبل الشراء." : "Unenrolled students can watch this before purchasing.")</small>
            </label>
        </div>

      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@(isRtl ? "إلغاء" : "Cancel")</button>
        <button type="button" class="btn btn-primary px-4" onclick="saveLesson()">@(isRtl ? "حفظ الدرس" : "Save Lesson")</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <!-- Include SortableJS from CDN for Drag and Drop -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        const courseId = @Model.CourseId;
        const isRtl = @isRtl.ToString().ToLower();

        // 1. Initialize SortableJS for Modules
        var modulesContainer = document.getElementById('modulesContainer');
        if(modulesContainer) {
            new Sortable(modulesContainer, {
                handle: '.module-header', // drag handle
                animation: 150,
                onEnd: function (evt) {
                    var order = [];
                    document.querySelectorAll('.module-card').forEach(function(el) {
                        order.push(parseInt(el.getAttribute('data-id')));
                    });
                    // AJAX call to reorder modules
                    fetch('/Curriculum/ReorderModules', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(order)
                    });
                }
            });

            // 2. Initialize SortableJS for Lessons inside each module
            document.querySelectorAll('.lesson-list').forEach(function(list) {
                new Sortable(list, {
                    group: 'lessons', // allow dragging between modules!
                    animation: 150,
                    onEnd: function (evt) {
                        var targetModuleId = evt.to.id.replace('lessonList_', '');
                        var lessonOrder = [];
                        evt.to.querySelectorAll('.lesson-item').forEach(function(el) {
                            lessonOrder.push(parseInt(el.getAttribute('data-id')));
                        });
                        
                        // AJAX call to reorder lessons inside the target module
                        fetch('/Curriculum/ReorderLessons', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ ModuleId: parseInt(targetModuleId), LessonIds: lessonOrder })
                        });
                    }
                });
            });
        }

        // --- Module Actions ---
        const moduleModal = new bootstrap.Modal(document.getElementById('moduleModal'));
        
        function openModuleModal() {
            document.getElementById('moduleId').value = '0';
            document.getElementById('modTitle').value = '';
            document.getElementById('modTitleAr').value = '';
            document.getElementById('moduleModalTitle').innerText = isRtl ? 'إضافة قسم' : 'Add Module';
            moduleModal.show();
        }

        function editModule(id, title, titleAr) {
            document.getElementById('moduleId').value = id;
            document.getElementById('modTitle').value = title;
            document.getElementById('modTitleAr').value = titleAr;
            document.getElementById('moduleModalTitle').innerText = isRtl ? 'تعديل قسم' : 'Edit Module';
            moduleModal.show();
        }

        function saveModule() {
            const id = document.getElementById('moduleId').value;
            const title = document.getElementById('modTitle').value;
            const titleAr = document.getElementById('modTitleAr').value;
            
            const url = id == '0' ? '/Curriculum/AddModule' : '/Curriculum/EditModule';
            const formData = new FormData();
            formData.append('courseId', courseId);
            formData.append('moduleId', id);
            formData.append('title', title);
            formData.append('titleAr', titleAr);

            fetch(url, { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    location.reload(); // Quick refresh for now to see new module UI
                }
            });
        }

        function deleteModule(id) {
            if(confirm(isRtl ? 'هل أنت متأكد من حذف هذا القسم وكل ما بداخله؟' : 'Are you sure you want to delete this module and all its lessons?')) {
                const formData = new FormData();
                formData.append('moduleId', id);
                fetch('/Curriculum/DeleteModule', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => { if(data.success) location.reload(); });
            }
        }

        // --- Lesson Actions ---
        const lessonModal = new bootstrap.Modal(document.getElementById('lessonModal'));
        
        function toggleLessonFields() {
            const type = document.getElementById('lessonType').value;
            const hint = document.getElementById('urlHint');
            if (type === 'Text') {
                document.getElementById('urlField').style.display = 'none';
                document.getElementById('textField').style.display = 'block';
            } else {
                document.getElementById('urlField').style.display = 'block';
                document.getElementById('textField').style.display = 'none';
                if(hint) {
                    hint.innerText = type === 'Video' 
                        ? (isRtl ? "ضع رابط فيديو يوتيوب أو رابط جوجل درايف العام." : "Paste a YouTube or public Google Drive link.")
                        : (isRtl ? "ضع رابط مباشر لتحميل الملف (Google Drive, Dropbox...)" : "Paste a direct download link (Google Drive, Dropbox...)");
                }
            }
        }

        function openLessonModal(moduleId) {
            document.getElementById('lessonId').value = '0';
            document.getElementById('lessonModuleId').value = moduleId;
            document.getElementById('lessonTitle').value = '';
            document.getElementById('lessonTitleAr').value = '';
            document.getElementById('lessonType').value = 'Video';
            document.getElementById('lessonUrl').value = '';
            document.getElementById('lessonText').value = '';
            document.getElementById('lessonDuration').value = '0';
            document.getElementById('lessonFreePreview').checked = false;
            document.getElementById('lessonModalTitle').innerText = isRtl ? 'إضافة درس' : 'Add Lesson';
            toggleLessonFields();
            lessonModal.show();
        }

        function editLesson(id, modId, title, titleAr, type, url, txt, dur, free) {
            document.getElementById('lessonId').value = id;
            document.getElementById('lessonModuleId').value = modId;
            document.getElementById('lessonTitle').value = title;
            document.getElementById('lessonTitleAr').value = titleAr;
            document.getElementById('lessonType').value = type;
            document.getElementById('lessonUrl').value = url;
            document.getElementById('lessonText').value = txt;
            document.getElementById('lessonDuration').value = dur;
            document.getElementById('lessonFreePreview').checked = free;
            document.getElementById('lessonModalTitle').innerText = isRtl ? 'تعديل درس' : 'Edit Lesson';
            toggleLessonFields();
            lessonModal.show();
        }

        function saveLesson() {
            const id = document.getElementById('lessonId').value;
            const modId = document.getElementById('lessonModuleId').value;
            const url = id == '0' ? '/Curriculum/AddLesson' : '/Curriculum/EditLesson';
            
            const formData = new FormData();
            formData.append('lessonId', id);
            formData.append('moduleId', modId);
            formData.append('title', document.getElementById('lessonTitle').value);
            formData.append('titleAr', document.getElementById('lessonTitleAr').value);
            formData.append('lessonType', document.getElementById('lessonType').value);
            formData.append('contentUrl', document.getElementById('lessonUrl').value);
            formData.append('textContent', document.getElementById('lessonText').value);
            formData.append('duration', document.getElementById('lessonDuration').value);
            formData.append('isFreePreview', document.getElementById('lessonFreePreview').checked);

            fetch(url, { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    location.reload(); 
                }
            });
        }

        function deleteLesson(id) {
            if(confirm(isRtl ? 'هل أنت متأكد من حذف هذا الدرس؟' : 'Are you sure you want to delete this lesson?')) {
                const formData = new FormData();
                formData.append('lessonId', id);
                fetch('/Curriculum/DeleteLesson', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => { if(data.success) location.reload(); });
            }
        }
    </script>
}
