@model IEnumerable<MentorDashboardApp.Models.User>

@{
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isRtl ? "إدارة المستخدمين" : "Manage Users";
    Layout = "_AdminLayout";
}

<div class="pagetitle d-flex justify-content-between align-items-center">
  <div>
    <h1>@(isRtl ? "إدارة المستخدمين (الطلاب)" : "Manage Users (Students)")</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="~/Admin/Index">@(isRtl ? "الرئيسية" : "Home")</a></li>
        <li class="breadcrumb-item active">@(isRtl ? "المستخدمين" : "Users")</li>
      </ol>
    </nav>
  </div>
</div>

<section class="section">
  <div class="row">
    <div class="col-lg-12">

      <div class="card">
        <div class="card-body">
          <h5 class="card-title">@(isRtl ? "قائمة الطلاب المسجلين" : "All Registered Students")</h5>

          <table class="table datatable">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">@(isRtl ? "الاسم" : "Name")</th>
                <th scope="col">@(isRtl ? "البريد الإلكتروني" : "Email")</th>
                <th scope="col">@(isRtl ? "تاريخ الانضمام" : "Joined Date")</th>
                <th scope="col">@(isRtl ? "الحالة" : "Status")</th>
                <th scope="col">@(isRtl ? "الإجراءات" : "Actions")</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in Model)
              {
                  <tr>
                    <th scope="row">@item.UserId</th>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if(item.IsActive)
                        {
                            <span class="badge bg-success">@(isRtl ? "نشط" : "Active")</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@(isRtl ? "موقوف" : "Inactive")</span>
                        }
                    </td>
                    <td>
                        <form method="post" action="/Admin/ToggleUserStatus" style="display:inline;">
                            <input type="hidden" name="id" value="@item.UserId" />
                            @if(item.IsActive)
                            {
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('@(isRtl ? "هل أنت متأكد من إيقاف هذا الحساب؟" : "Are you sure you want to deactivate this user?")');">@(isRtl ? "إيقاف" : "Deactivate")</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('@(isRtl ? "هل أنت متأكد من تفعيل هذا الحساب؟" : "Are you sure you want to activate this user?")');">@(isRtl ? "تفعيل" : "Activate")</button>
                            }
                        </form>
                    </td>
                  </tr>
              }
            </tbody>
          </table>

        </div>
      </div>

    </div>
  </div>
</section>
