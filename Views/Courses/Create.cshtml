@model MentorDashboardApp.Models.Course
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["AddCourse"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
}

<div class="pagetitle">
  <h1>@Localizer["AddCourse"]</h1>
  <nav>
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/Admin/Index">@Localizer["Home"]</a></li>
      <li class="breadcrumb-item"><a href="/Courses/Index">@Localizer["Courses"]</a></li>
      <li class="breadcrumb-item active">@Localizer["AddCourse"]</li>
    </ol>
  </nav>
</div>

<section class="section">
  <div class="row">
    <div class="col-lg-12">

      <div class="card">
        <div class="card-body pt-3">
          <!-- Bordered Tabs -->
          <ul class="nav nav-tabs nav-tabs-bordered" id="courseTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic-info" type="button" role="tab" aria-controls="basic-info" aria-selected="true">@Localizer["BasicInfo"]</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="media-tab" data-bs-toggle="tab" data-bs-target="#media-resources" type="button" role="tab" aria-controls="media-resources" aria-selected="false">@Localizer["MediaResources"]</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="pricing-tab" data-bs-toggle="tab" data-bs-target="#pricing-settings" type="button" role="tab" aria-controls="pricing-settings" aria-selected="false">@Localizer["PricingSettings"]</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="seo-tab" data-bs-toggle="tab" data-bs-target="#seo-meta" type="button" role="tab" aria-controls="seo-meta" aria-selected="false">@Localizer["DetailsSEO"]</button>
            </li>
          </ul>

          <form asp-action="Create" method="post" enctype="multipart/form-data" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="tab-content pt-2" id="courseTabsContent">
                
                <!-- 1. BASIC INFO TAB -->
                <div class="tab-pane fade show active" id="basic-info" role="tabpanel" aria-labelledby="basic-tab">
                    
                    @if (isRtl)
                    {
                        <!-- Arabic Data Fields -->
                        <div id="ar-data">
                            <div class="mb-3">
                                <label for="TitleAr" class="form-label fw-bold">عنوان الكورس *</label>
                                <input asp-for="TitleAr" class="form-control" dir="rtl" required />
                            </div>
                            <div class="mb-4">
                                <label for="DescriptionAr" class="form-label fw-bold">وصف الكورس *</label>
                                <textarea asp-for="DescriptionAr" class="form-control tinymce-editor" style="height: 150px" dir="rtl"></textarea>
                            </div>
                            <div class="mb-4">
                                <label for="WhatYouWillLearnAr" class="form-label fw-bold">ماذا ستتعلم؟</label>
                                <textarea asp-for="WhatYouWillLearnAr" class="form-control tinymce-editor" style="height: 100px" dir="rtl"></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="TargetAudienceAr" class="form-label fw-bold">الجمهور المستهدف</label>
                                <input asp-for="TargetAudienceAr" class="form-control" placeholder="مثال: المبتدئين..." dir="rtl" />
                            </div>
                            <div class="mb-3">
                                <label for="PrerequisitesAr" class="form-label fw-bold">المتطلبات السابقة</label>
                                <input asp-for="PrerequisitesAr" class="form-control" placeholder="مثال: معرفة أساسيات الويب" dir="rtl" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- English Data Fields -->
                        <div id="en-data">
                            <div class="mb-3">
                                <label for="Title" class="form-label fw-bold">Course Title *</label>
                                <input asp-for="Title" class="form-control" required dir="ltr" />
                            </div>
                            <div class="mb-4">
                                <label for="Description" class="form-label fw-bold">Description *</label>
                                <textarea asp-for="Description" class="form-control tinymce-editor" style="height: 150px" dir="ltr"></textarea>
                            </div>
                            <div class="mb-4">
                                <label for="WhatYouWillLearn" class="form-label fw-bold">What You Will Learn</label>
                                <textarea asp-for="WhatYouWillLearn" class="form-control tinymce-editor" style="height: 100px" dir="ltr"></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="TargetAudience" class="form-label fw-bold">Target Audience</label>
                                <input asp-for="TargetAudience" class="form-control" placeholder="e.g. Beginners..." dir="ltr" />
                            </div>
                            <div class="mb-3">
                                <label for="Prerequisites" class="form-label fw-bold">Prerequisites</label>
                                <input asp-for="Prerequisites" class="form-control" placeholder="e.g. Basic knowledge of HTML" dir="ltr" />
                            </div>
                        </div>
                    }
                </div>

                <!-- 2. MEDIA & RESOURCES TAB -->
                <div class="tab-pane fade" id="media-resources" role="tabpanel" aria-labelledby="media-tab">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card bg-light border-0 shadow-none mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">@(isRtl ? "صورة الكورس" : "Course Image")</h5>
                                    <div class="form-check form-check-inline mb-2">
                                      <input class="form-check-input" type="radio" name="ImageSource" id="imgUpload" value="upload" checked onchange="toggleImageSource()">
                                      <label class="form-check-label" for="imgUpload">@(isRtl ? "رفع من الجهاز" : "Upload from Device")</label>
                                    </div>
                                    <div class="form-check form-check-inline mb-2">
                                      <input class="form-check-input" type="radio" name="ImageSource" id="imgLink" value="link" onchange="toggleImageSource()">
                                      <label class="form-check-label" for="imgLink">@(isRtl ? "رابط خارجي" : "External Link")</label>
                                    </div>
                                    <div id="uploadDiv" class="mb-3">
                                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                                    </div>
                                    <div id="linkDiv" class="mb-3" style="display:none;">
                                        <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card bg-light border-0 shadow-none">
                                <div class="card-body">
                                    <h5 class="card-title">@(isRtl ? "المرفقات" : "Resources")</h5>
                                    <div class="mb-3">
                                        <label for="syllabusFile" class="form-label">@(isRtl ? "المنهج / المادة العلمية (PDF/ZIP)" : "Syllabus / Material (PDF/ZIP)")</label>
                                        <input type="file" name="syllabusFile" class="form-control" accept=".pdf,.zip,.doc,.docx" />
                                        <small class="text-muted">@(isRtl ? "ارفع خطة الكورس ليتمكن الطلاب من تحميلها." : "Upload the course plan for students to download.")</small>
                                    </div>
                                    <div class="mb-3">
                                        <label for="CommunityLink" class="form-label">@(isRtl ? "رابط مجتمع الطلاب (WhatsApp/Discord)" : "Community Link (WhatsApp/Discord)")</label>
                                        <input asp-for="CommunityLink" class="form-control" placeholder="https://chat.whatsapp.com/..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-light border-0 shadow-none">
                                <div class="card-body">
                                    <h5 class="card-title">@(isRtl ? "الفيديو الترويجي (معاينة مباشرة)" : "Promo Video (Live Preview)")</h5>
                                    <div class="mb-3">
                                        <label for="VideoPlatform" class="form-label">@(isRtl ? "المنصة" : "Platform")</label>
                                        <select asp-for="VideoPlatform" class="form-select" id="VideoPlatform" onchange="previewVideo()">
                                            <option value="">@(isRtl ? "لا يوجد" : "None")</option>
                                            <option value="YouTube">YouTube</option>
                                            <option value="GoogleDrive">Google Drive</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="VideoUrl" class="form-label">@(isRtl ? "رابط الفيديو" : "Video URL")</label>
                                        <input asp-for="VideoUrl" class="form-control" id="VideoUrl" placeholder="@(isRtl ? "انسخ الرابط هنا..." : "Paste link here...")" oninput="previewVideo()" />
                                    </div>
                                    <div id="videoPreviewContainer" class="mt-3 text-center" style="display:none;">
                                        <h6>@(isRtl ? "معاينة:" : "Preview:")</h6>
                                        <div id="videoPreview" class="ratio ratio-16x9 border"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. PRICING & SETTINGS TAB -->
                <div class="tab-pane fade" id="pricing-settings" role="tabpanel" aria-labelledby="pricing-tab">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="PaymentType" class="form-label fw-bold">@(isRtl ? "نوع الدفع" : "Payment Type")</label>
                            <select asp-for="PaymentType" class="form-select">
                                <option value="Paid">@(isRtl ? "مدفوع (مرة واحدة)" : "Paid (One-time)")</option>
                                <option value="Free">@(isRtl ? "مجاني" : "Free")</option>
                                <option value="Subscription">@(isRtl ? "اشتراك" : "Subscription")</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="Price" class="form-label fw-bold">@(isRtl ? "السعر الأساسي ($)" : "Regular Price ($)")</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" required value="0" />
                        </div>
                        <div class="col-md-4">
                            <label for="DiscountPrice" class="form-label fw-bold">@(isRtl ? "السعر بعد الخصم ($)" : "Discounted Price ($)")</label>
                            <input asp-for="DiscountPrice" type="number" step="0.01" class="form-control" placeholder="@(isRtl ? "اتركه فارغاً إذا لم يكن هناك خصم" : "Leave empty if no discount")" />
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="Status" class="form-label fw-bold">@(isRtl ? "حالة الكورس" : "Course Status")</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Draft">@(isRtl ? "مسودة (مخفي)" : "Draft (Hidden)")</option>
                                <option value="Published">@(isRtl ? "منشور (متاح للطلاب)" : "Published (Live)")</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="StartDate" class="form-label fw-bold">@(isRtl ? "تاريخ البدء (اختياري)" : "Start Date (Optional)")</label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label for="EndDate" class="form-label fw-bold">@(isRtl ? "تاريخ الانتهاء (اختياري)" : "End Date (Optional)")</label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="MaxCapacity" class="form-label fw-bold">@(isRtl ? "أقصى عدد للطلاب" : "Max Capacity (Students)")</label>
                            <input asp-for="MaxCapacity" type="number" class="form-control" placeholder="@(isRtl ? "اتركه فارغاً لعدد غير محدود" : "Leave empty for unlimited")" />
                        </div>
                    </div>

                    <hr>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="HasCertificate">
                                <label class="form-check-label" for="HasCertificate">@(isRtl ? "يمنح شهادة؟" : "Offers Certificate?")</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="AcceptsCoupons" checked>
                                <label class="form-check-label" for="AcceptsCoupons">@(isRtl ? "يقبل كوبونات الخصم؟" : "Accept Coupons?")</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsFeatured">
                                <label class="form-check-label" for="IsFeatured">@(isRtl ? "كورس مميز (في الواجهة)؟" : "Featured Course?")</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. DETAILS & SEO TAB -->
                <div class="tab-pane fade" id="seo-meta" role="tabpanel" aria-labelledby="seo-tab">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="Category" class="form-label fw-bold">@(isRtl ? "القسم" : "Category")</label>
                            <input asp-for="Category" class="form-control" placeholder="@(isRtl ? "مثال: برمجة" : "e.g. Programming")" />
                        </div>
                        <div class="col-md-3">
                            <label for="Level" class="form-label fw-bold">@(isRtl ? "المستوى" : "Level")</label>
                            <select asp-for="Level" class="form-select">
                                <option value="Beginner">@(isRtl ? "مبتدئ" : "Beginner")</option>
                                <option value="Intermediate">@(isRtl ? "متوسط" : "Intermediate")</option>
                                <option value="Advanced">@(isRtl ? "متقدم" : "Advanced")</option>
                                <option value="All Levels">@(isRtl ? "جميع المستويات" : "All Levels")</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="Language" class="form-label fw-bold">@(isRtl ? "لغة الشرح" : "Language")</label>
                            <select asp-for="Language" class="form-select">
                                <option value="Arabic">@(isRtl ? "عربي" : "Arabic")</option>
                                <option value="English">@(isRtl ? "إنجليزي" : "English")</option>
                                <option value="French">@(isRtl ? "فرنسي" : "French")</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="Duration" class="form-label fw-bold">@(isRtl ? "المدة الإجمالية" : "Duration")</label>
                            <input asp-for="Duration" class="form-control" placeholder="@(isRtl ? "مثال: 10 ساعات" : "e.g. 10 Hours")" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="TotalLessons" class="form-label fw-bold">@(isRtl ? "عدد الدروس" : "Total Lessons")</label>
                            <input asp-for="TotalLessons" type="number" class="form-control" placeholder="@(isRtl ? "مثال: 25" : "e.g. 25")" />
                        </div>
                        <div class="col-md-6">
                            <label for="Tags" class="form-label fw-bold">@(isRtl ? "كلمات دلالية (Tags)" : "Tags")</label>
                            <input asp-for="Tags" class="form-control" placeholder="@(isRtl ? "مثال: C#, ويب" : "e.g. C#, Backend, Web")" />
                        </div>
                    </div>

                    <hr>
                    <h6 class="fw-bold">@(isRtl ? "تحسين محركات البحث (SEO)" : "SEO (Search Engine Optimization)")</h6>
                    <div class="mb-3">
                        <label for="SeoTitle" class="form-label">@(isRtl ? "عنوان السيو" : "SEO Title")</label>
                        <input asp-for="SeoTitle" class="form-control" placeholder="@(isRtl ? "بحد أقصى 60 حرفاً..." : "Max 60 characters...")" />
                    </div>
                    <div class="mb-3">
                        <label for="SeoDescription" class="form-label">@(isRtl ? "وصف السيو" : "SEO Description")</label>
                        <textarea asp-for="SeoDescription" class="form-control" rows="2" placeholder="@(isRtl ? "بحد أقصى 160 حرفاً..." : "Max 160 characters...")"></textarea>
                    </div>
                </div>

            </div>

            <div class="text-center mt-5 mb-3 border-top pt-4">
                <button type="submit" class="btn btn-primary btn-lg px-5">@(isRtl ? "حفظ الكورس" : "Save Course")</button>
                <a href="/Courses/Index" class="btn btn-secondary btn-lg px-4">@(isRtl ? "إلغاء" : "Cancel")</a>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>

@section Scripts {
    <script>
        function toggleImageSource() {
            if (document.getElementById('imgUpload').checked) {
                document.getElementById('uploadDiv').style.display = 'block';
                document.getElementById('linkDiv').style.display = 'none';
                document.getElementById('ImageUrl').value = '';
            } else {
                document.getElementById('uploadDiv').style.display = 'none';
                document.getElementById('linkDiv').style.display = 'block';
            }
        }

        function previewVideo() {
            var platform = document.getElementById('VideoPlatform').value;
            var url = document.getElementById('VideoUrl').value;
            var container = document.getElementById('videoPreviewContainer');
            var preview = document.getElementById('videoPreview');

            if (!url || !platform) {
                container.style.display = 'none';
                preview.innerHTML = '';
                return;
            }

            container.style.display = 'block';
            
            if (platform === 'YouTube') {
                var videoId = extractYouTubeId(url);
                if (videoId) {
                    preview.innerHTML = '<iframe src="https://www.youtube.com/embed/' + videoId + '" title="YouTube video" allowfullscreen></iframe>';
                } else {
                    preview.innerHTML = '<p class="text-danger mt-3">Invalid YouTube Link</p>';
                }
            } else if (platform === 'GoogleDrive') {
                var driveId = extractGoogleDriveId(url);
                if (driveId) {
                    preview.innerHTML = '<iframe src="https://drive.google.com/file/d/' + driveId + '/preview" title="Drive video" allowfullscreen></iframe>';
                } else {
                    preview.innerHTML = '<p class="text-danger mt-3">Invalid Google Drive Link</p>';
                }
            }
        }

        function extractYouTubeId(url) {
            var regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            var match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }

        function extractGoogleDriveId(url) {
            var regExp = /[-\w]{25,}/;
            var match = url.match(regExp);
            return match ? match[0] : null;
        }
    </script>
}
