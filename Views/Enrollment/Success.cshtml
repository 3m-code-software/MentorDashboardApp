@model MentorDashboardApp.Models.Course
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
    var isRtl = currentCulture.StartsWith("ar");
    var title = isRtl && !string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleAr : Model.Title;
    ViewData["Title"] = isRtl ? "تم التسجيل بنجاح" : "Enrollment Successful";
    Layout = "_FrontendLayout";
}

<div class="container mt-5 mb-5 text-center @(isRtl ? "rtl" : "")" style="min-height: 60vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    
    <div class="mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 6rem;"></i>
    </div>
    
    <h1 class="display-5 fw-bold mb-3">@(isRtl ? "تهانينا! تمت العملية بنجاح" : "Congratulations! Successful Enrollment")</h1>
    
    <p class="lead text-muted mb-4" style="max-width: 600px;">
        @(isRtl ? $"أهلاً بك! لقد أصبحت الآن طالباً مسجلاً في كورس '{title}'. لقد تم تفعيل حسابك ويمكنك البدء في التعلم فوراً." : $"Welcome! You are now successfully enrolled in '{title}'. Your account is active and you can start learning immediately.")
    </p>
    
    <div class="card shadow-sm border-0 mb-4" style="max-width: 500px; width: 100%; text-align: start;">
        <div class="card-body p-4 bg-light rounded">
            <h5 class="fw-bold border-bottom pb-2 mb-3">@(isRtl ? "تفاصيل الطلب" : "Order Details")</h5>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">@(isRtl ? "رقم الطلب:" : "Order Number:")</span>
                <strong>#ORD-@(new Random().Next(10000, 99999))</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">@(isRtl ? "اسم الكورس:" : "Course Name:")</span>
                <strong>@title</strong>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">@(isRtl ? "حالة الدفع:" : "Payment Status:")</span>
                <strong class="text-success"><i class="bi bi-shield-check"></i> @(isRtl ? "مكتمل" : "Completed")</strong>
            </div>
        </div>
    </div>
    
    <div class="mt-2">
        <a href="/LMS/Player?courseId=@Model.CourseId" class="btn btn-primary btn-lg rounded-pill fw-bold shadow px-5 py-3">
            <i class="bi bi-play-circle-fill me-2"></i> @(isRtl ? "ابدأ التعلم الآن" : "Start Learning Now")
        </a>
    </div>
    
    <div class="mt-3">
        <a href="/Home/Index" class="text-decoration-none text-muted">
            <i class="bi bi-house me-1"></i> @(isRtl ? "العودة للوحة التحكم" : "Return to Dashboard")
        </a>
    </div>
</div>
