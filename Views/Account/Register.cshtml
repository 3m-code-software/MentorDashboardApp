@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
    var isRtl = currentCulture.StartsWith("ar");
    ViewData["Title"] = isRtl ? "إنشاء حساب جديد" : "Register";
    Layout = "_FrontendLayout";
}

<div class="page-title dark-background" data-aos="fade" style="background: url('/frontend/assets/img/page-title-bg.jpg') center center; background-size: cover; padding: 60px 0;">
  <div class="container text-center">
    <h1>@(isRtl ? "إنشاء حساب" : "Register")</h1>
  </div>
</div>

<section class="section">
    <div class="container mt-5 mb-5 @(isRtl ? "rtl" : "")">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0" style="border-radius: 12px;">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="bi bi-person-plus text-primary" style="font-size: 3rem;"></i>
                            <h4 class="mt-2 fw-bold">@(isRtl ? "انضم إلينا الآن!" : "Join Us Now!")</h4>
                            <p class="text-muted">@(isRtl ? "أنشئ حسابك للبدء في رحلة التعلم" : "Create your account to start your learning journey")</p>
                        </div>
                        
                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
                            </div>
                        }

                        <form method="post" action="/Account/Register">
                            <div class="mb-3">
                                <label class="form-label fw-bold">@(isRtl ? "الاسم الكامل" : "Full Name")</label>
                                <input type="text" name="fullName" class="form-control" style="padding: 12px; border-radius: 8px;" placeholder="@(isRtl ? "مثال: أحمد محمد" : "e.g. John Doe")" required>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">@(isRtl ? "البريد الإلكتروني" : "Email Address")</label>
                                <input type="email" name="email" class="form-control" style="padding: 12px; border-radius: 8px;" placeholder="name@example.com" required>
                            </div>
                            
                            <div class="mb-4">
                                <label class="form-label fw-bold">@(isRtl ? "كلمة المرور" : "Password")</label>
                                <input type="password" name="password" class="form-control" style="padding: 12px; border-radius: 8px;" placeholder="********" required>
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold" style="padding: 12px; border-radius: 50px;">
                                @(isRtl ? "إنشاء حساب" : "Create Account")
                            </button>
                        </form>
                        
                        <div class="text-center mt-4">
                            <p class="text-muted mb-0">@(isRtl ? "لديك حساب بالفعل؟" : "Already have an account?") 
                                <a href="/Account/Login" class="text-primary fw-bold text-decoration-none">@(isRtl ? "سجل دخولك" : "Sign In")</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
