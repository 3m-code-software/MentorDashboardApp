@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
    var isRtl = currentCulture.StartsWith("ar");
    ViewData["Title"] = isRtl ? "استعادة كلمة المرور" : "Forgot Password";
    Layout = "_FrontendLayout";
}

<div class="page-title dark-background" data-aos="fade" style="background: url('/frontend/assets/img/page-title-bg.jpg') center center; background-size: cover; padding: 60px 0;">
  <div class="container text-center">
    <h1>@(isRtl ? "استعادة كلمة المرور" : "Forgot Password")</h1>
  </div>
</div>

<section class="section">
    <div class="container mt-5 mb-5 @(isRtl ? "rtl" : "")">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0" style="border-radius: 12px;">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="bi bi-key-fill text-primary" style="font-size: 3rem;"></i>
                            <h4 class="mt-2 fw-bold">@(isRtl ? "نسيت كلمة السر؟" : "Forgot Password?")</h4>
                            <p class="text-muted">@(isRtl ? "أدخل بريدك الإلكتروني وسنرسل لك رابطاً لإعادة تعيينها" : "Enter your email and we will send you a reset link")</p>
                        </div>
                        
                        @if (ViewBag.SuccessMessage != null)
                        {
                            <div class="alert alert-success" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.SuccessMessage
                            </div>
                        }

                        <form method="post" action="/Account/ForgotPassword">
                            <div class="mb-4">
                                <label class="form-label fw-bold">@(isRtl ? "البريد الإلكتروني" : "Email Address")</label>
                                <input type="email" name="email" class="form-control" style="padding: 12px; border-radius: 8px;" placeholder="name@example.com" required>
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold" style="padding: 12px; border-radius: 50px;">
                                <i class="bi bi-envelope-paper me-2"></i> @(isRtl ? "إرسال رابط الاستعادة" : "Send Reset Link")
                            </button>
                        </form>
                        
                        <div class="text-center mt-4">
                            <a href="/Account/Login" class="text-secondary text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i> @(isRtl ? "العودة لتسجيل الدخول" : "Back to Login")
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
